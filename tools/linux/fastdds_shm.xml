<?xml version="1.0" encoding="UTF-8" ?>
<!-- ROS 2 (Fast DDS) on this WSL machine: shared memory only. With WSL's mirrored networking, discovery over UDP
     finds the other processes but no data arrives (not even ROS's own talker/listener demo); every node runs on this
     one machine, so shared memory carries everything. Segments are big enough for a 1280x720 colour picture.
     Not needed on the robot. Used via FASTDDS_DEFAULT_PROFILES_FILE in tools/linux/env.sh. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="sprocket_shm" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>shm</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
