[Unit]
Description=Sprocket robot harness (control, perception, cognition)
After=network.target sprocket-llm.service arduino-router.service
Wants=sprocket-llm.service

[Service]
User=@USER@
WorkingDirectory=@REPO@
Environment=PYTHONUNBUFFERED=1
ExecStart=@RT@/venv/bin/python -m robot --config config/robot.ventuno.yaml --headless --no-dashboard
# Real-time control thread: SCHED_FIFO up to 60 and locked memory (robot/core/realtime.py).
LimitRTPRIO=60
LimitMEMLOCK=infinity
AmbientCapabilities=CAP_SYS_NICE CAP_IPC_LOCK
Nice=-5
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
